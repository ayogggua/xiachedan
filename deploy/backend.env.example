NODE_ENV=production
CHAT_MODE=cloud
CHAT_SERVE_WEB=false
PORT=4318
CHAT_DATA_DIR=/data
CHAT_SPACE_NAME=虾扯蛋
# 填写前端正式 HTTPS 根地址，不带末尾斜线。
CHAT_PUBLIC_URL=https://chat.example.com
# 逗号分隔的精确来源；独立域名前端也需要列在这里。
CHAT_ALLOWED_ORIGINS=https://chat.example.com
# 后端端口仅绑定服务器回环地址，信任紧邻的 Nginx 代理。
CHAT_TRUST_PROXY=1
CHAT_COOKIE_SAME_SITE=lax
CHAT_MAX_STORAGE_BYTES=10737418240
